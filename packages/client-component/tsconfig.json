{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "composite": false,
        "declaration": true,
        "declarationMap": true,
        "skipLibCheck": true,
        "noEmit": false,
        "resolveJsonModule": true,
        "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
        "paths": {
            "@zdocs/util": [
                "../util/src"
            ],
            "@zdocs/types": [
                "../types/src"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.json"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}