# Folder to watch (e.g. a Google Drive "mirror files" folder)
DOC_AI_WATCH_DIR=~/Documents/doc-ai-inbox
# Database + caches
DOC_AI_DATA_DIR=~/.doc-ai

# AI provider: normally chosen in the setup wizard when you first open the UI.
# ollama | local | gateway | openrouter | openai | anthropic | google
# DOC_AI_PROVIDER=gateway
# AI_GATEWAY_API_KEY=

# OLLAMA_BASE_URL=http://localhost:11434
# DOC_AI_OLLAMA_MODEL=qwen3.5:9b

# PORT=4310
