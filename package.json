{
  "name": "doc-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Local, single-user document intelligence: watch a folder, classify and extract documents, query them over MCP.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @doc-ai/web",
    "start": "npm run build && npm run start -w @doc-ai/server",
    "dev": "npm run dev -w @doc-ai/server",
    "dev:web": "npm run dev -w @doc-ai/web",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/papaparse": "^5.5.2",
    "ag-grid-community": "^34.3.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
