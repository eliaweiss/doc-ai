{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": [
      "node"
    ],
    "baseUrl": "../..",
    "paths": {
      "next/server": [
        "apps/server/src/next-compat/server.ts"
      ],
      "next-auth": [
        "apps/server/src/next-compat/next-auth.ts"
      ],
      "next-auth/next": [
        "apps/server/src/next-compat/next-auth.ts"
      ],
      "@/app/session-auth/auth-config": [
        "apps/server/src/next-compat/auth-config.ts"
      ],
      "@/app/api/*": [
        "apps/server/src/zdocs-api/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts"
  ]
}